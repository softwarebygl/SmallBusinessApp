    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to scan receipts with the document camera."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para escanear recibos con la cámara de documentos."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to import a contact into a customer, employee, or subcontractor, and to save them back to your phone’s contacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para importar un contacto como cliente, empleado o subcontratista, y para guardarlos en los contactos de tu teléfono."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to lock the app and to protect sensitive details — your Tax IDs (SSN/EIN), tax documents (W-9, 1099), and your saved signature — before they’re shown, exported, or added to a document."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para bloquear la app y proteger información confidencial (tus números de identificación fiscal, documentos fiscales y firma guardada) antes de mostrarlos, exportarlos o agregarlos a un documento."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to dictate what you ask the assistant, so you can talk instead of type. Your voice is turned into text on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para dictarle al asistente y hablar en vez de escribir. Tu voz se convierte en texto en este iPhone."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to turn what you say to the assistant into text. Speech recognition runs on this iPhone; nothing is sent until you tap Send."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para convertir en texto lo que le dices al asistente. El reconocimiento de voz se ejecuta en este iPhone; no se envía nada hasta que toques Enviar."
          }
        }
      }
    }
  },
  "version" : "1.0"
}