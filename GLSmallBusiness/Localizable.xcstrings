          }
        }
      }
    },
    "A deleted change order’s items couldn’t be matched on its invoice, so they’re still on it. Remove them from the invoice’s line items by hand.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas de una orden de cambio eliminada no se pudieron identificar en su factura, así que siguen ahí. Quítalas a mano de las partidas de la factura."
          }
        }
      }
    },
    "A flat amount owed, not tied to hours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monto fijo adeudado, no ligado a horas."
          }
