    "Personal" : {

    },
    "Personalize the app with your uploaded company logo — it appears on the Menu button and faintly behind your screens. Turn this off to use the app’s built-in monogram instead." : {
      "localizations" : {
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalitzeu l'aplicació amb el logotip de la vostra empresa que heu pujat: apareix al botó de menú i tènuement darrere de les pantalles. Desactiveu-ho per fer servir el monograma integrat de l'aplicació."
          }
        },
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalise the app with your uploaded company logo — it appears on the Menu button and faintly behind your screens. Turn this off to use the app’s built-in monogram instead."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza la app con el logotipo de tu empresa que has subido: aparece en el botón de menú y tenuemente detrás de tus pantallas. Desactiva esta opción para usar el monograma integrado de la app."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personaliza la app con el logo de tu empresa que subiste: aparece en el botón de Menú y de forma tenue detrás de tus pantallas. Desactívalo para usar el monograma integrado de la app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize o app com o logotipo da sua empresa — ele aparece no botão Menu e discretamente ao fundo das suas telas. Desative para usar o monograma integrado do app."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personalize a aplicação com o logótipo da empresa que carregou — aparece no botão Menu e ténue por trás dos ecrãs. Desative para usar o monograma incorporado na aplicação."
          }
        }
      }
    },
