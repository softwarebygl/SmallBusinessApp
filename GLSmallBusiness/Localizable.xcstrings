            "state": "translated",
            "value": "Your provider API keys stay in your control: connect for a single sign-in session or save them in your encrypted iCloud Keychain for your Gold Life ID. Gold Life servers never receive or store your keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API de sus proveedores permanecen bajo su control: conéctelas para una sola sesión o guárdelas en su Llavero de iCloud cifrado para su Gold Life ID. Los servidores de Gold Life nunca reciben ni almacenan sus claves."
          }
        }
      }
    },
    "Your purchases have been restored. If you have an active subscription, it’s now active on this device.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se restauraron tus compras. Si tienes una suscripción activa, ya está activa en este dispositivo."
          }
        }
      }
    },
    "Your records back up to your Gold Life account. This device stopped because another one deleted an unusual number of items at once.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros se respaldan en tu cuenta de Gold Life. Este dispositivo se detuvo porque otro eliminó una cantidad inusual de elementos a la vez."
          }
        }
      }
    },
    "Your signature": {
      "localizations": {
        "es": {
