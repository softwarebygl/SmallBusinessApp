    "I’m Sentinel, running privately on this device with Apple Intelligence. How can I help you today?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I’m Sentinel, running privately on this device with Apple Intelligence. How can I help you today?"
