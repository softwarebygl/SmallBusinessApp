    },
    "A flat amount, not tied to hours. Add a pay rate to their profile to log time as hours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un monto fijo, no ligado a horas. Agrega una tarifa de pago a su perfil para registrar el tiempo como horas."
