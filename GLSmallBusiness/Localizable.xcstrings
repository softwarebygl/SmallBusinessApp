    },
    "A one-time bonus on top of the salary. It’s added to what’s owed until it’s paid.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bono único además del salario. Se suma a lo adeudado hasta que se pague."
