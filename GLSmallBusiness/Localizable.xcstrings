    "Thank you": {
      "extractionState": "migrated",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias"
          }
        }
      }
    },
    "Thank you for being the best part of Gold Life! Your support makes all of this possible!": {
      "extractionState": "migrated",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por ser lo mejor de Gold Life! Tu apoyo hace posible todo esto."
          }
        }
      }
    },
    "Thank you for your payment. This receipt confirms the amount received above.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias por tu pago. Este recibo confirma el monto recibido que se muestra arriba."
          }
        }
      }
    },
    "Thank you — this invoice is now paid in full. We appreciate your business.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gracias: esta factura ya está pagada por completo. Agradecemos tu preferencia."
          }
        }
      }
    },
    "Thanksgiving": {
      "extractionState": "migrated",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanksgiving"
          }
        },
        "es": {
