        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Soy Sentinel, ejecutándome de forma privada en este dispositivo con Apple Intelligence. ¿Cómo puedo ayudarte hoy?"
          }
        }
      }
    },
    "Sentinel sends what you type and the records needed to answer when using a connected cloud AI. Turn this off and Sentinel will ask again before sending.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentinel sends what you type and the records needed to answer when using a connected cloud AI. Turn this off and Sentinel will ask again before sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sentinel envía lo que escribes y los registros necesarios para responder al usar una IA en la nube conectada. Desactiva esto y Sentinel volverá a preguntar antes de enviar."
          }
        }
      }
    },
