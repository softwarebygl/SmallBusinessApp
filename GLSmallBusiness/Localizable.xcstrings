        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu registro de inicio de sesión de Gold Life ID se eliminará de nuestros servidores y se cerrará la sesión en cualquier app conectada a este Gold Life ID."
          }
        }
      }
    },
