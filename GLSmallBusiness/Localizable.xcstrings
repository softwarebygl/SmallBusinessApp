          }
        }
      }
    },
    "You are Sentinel, the AI agent inside My Business, answering with no internet connection. You can look things up with find, get and report, and nothing else. You cannot add or change anything: if the person asks for a change, say “I’ll need a connection to make that change.” Answer briefly, in the person’s own words, and never invent a number, a name or a date.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are Sentinel, the AI agent inside My Business, answering with no internet connection. You can look things up with find, get and report, and nothing else. You cannot add or change anything: if the person asks for a change, say “I’ll need a connection to make that change.” Answer briefly, in the person’s own words, and never invent a number, a name or a date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eres Sentinel, el agente de IA dentro de My Business, respondiendo sin conexión a internet. Puedes consultar datos con find, get y report, y nada más. No puedes agregar ni cambiar nada: si la persona pide un cambio, di “Necesito conexión para hacer ese cambio.” Responde brevemente, con las palabras de la persona, y nunca inventes un número, un nombre ni una fecha."
          }
        }
      }
    },
    "Connect an AI to continue. Tap the AI menu above the message bar or the CPU button in the top bar to connect ChatGPT, Claude, Gemini, or Muse.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect an AI to continue. Tap the AI menu above the message bar or the CPU button in the top bar to connect ChatGPT, Claude, Gemini, or Muse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una IA para continuar. Toca el menú de IA sobre la barra de mensajes o el botón de CPU en la barra superior para conectar ChatGPT, Claude, Gemini o Muse."
          }
        }
      }
    },
    "%@ isn’t connected yet. Tap the AI menu above the message bar to connect %@ or switch to one of your connected AIs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isn’t connected yet. Tap the AI menu above the message bar to connect %@ or switch to one of your connected AIs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aún no está conectado. Toca el menú de IA sobre la barra de mensajes para conectar %@ o cambia a una de tus IA conectadas."
          }
        }
      }
    }
  },
  "version": "1.1"
