        }
      }
    },
    "A paid invoice can’t be changed or deleted, and neither can the customer it belongs to. Add a change order to correct it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una factura pagada no se puede modificar ni eliminar, y tampoco el cliente al que pertenece. Agrega una orden de cambio para corregirla."
          }
        }
      }
    },
    "A paycheck was already recorded this period (%@ · %@). Saving records another one.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
