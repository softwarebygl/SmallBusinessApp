    "Your subscription ended": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción terminó"
          }
        }
      }
    },
    "Your subscription ended, so this change didn’t back up. It’s still saved here — reactivate to start syncing again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción terminó, así que este cambio no se respaldó. Sigue guardado aquí: reactiva para volver a sincronizar."
          }
        }
      }
    },
    "Your subscription ended, so your records are read-only. Everything is still here to read. Nothing can be added, changed or exported until you reactivate.": {
      "extractionState": "migrated",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu suscripción terminó, así que tus registros son de solo lectura. Todo sigue aquí para consultarlo. No se puede agregar, cambiar ni exportar nada hasta que reactives."
          }
        }
      }
    },
